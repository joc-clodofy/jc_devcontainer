{
  "name": "odoo",
  "initializeCommand": "docker network inspect shared-net >/dev/null 2>&1 || docker network create shared-net",
  "dockerComposeFile": "docker-compose.yml",
  "service": "odoo-dev",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "mvintg.odoo-file",
        "odoo.owl-vision",
        "trinhanhngoc.vscode-odoo",
        "esbenp.prettier-vscode",
        "charliermarsh.ruff",
        "DotJoshJohnson.xml",
        "codezombiech.gitignore",
        "usernamehw.errorlens",
        "formulahendry.auto-complete-tag",
        "mrorz.language-gettext",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.languageServer": "None",
        "editor.tabSize": 4,
        "terminal.integrated.cursorStyle": "underline",
        "terminal.integrated.cursorBlinking": true,
        "terminal.integrated.fontLigatures.enabled": true,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "python.defaultInterpreterPath": ".venv/bin/python",
        "python.terminal.activateEnvInCurrentTerminal": true
      }
    }
  },
  "mounts": [
    {
      "source": "zshhistory",
      "target": "/commandhistory",
      "type": "volume"
    },
    {
      "source": "${localEnv:HOME}/.ssh",
      "target": "/home/odoo/.ssh",
      "type": "bind"
    }
  ],
  "remoteUser": "odoo",
  "containerUser": "odoo",
  "postCreateCommand": "cd /workspace && uv sync --inexact && uv pip install -r odoo/requirements.txt && uv pip install -r requirements-addons-manifests.txt",
  "postAttachCommand": "cd /workspace && uv sync --inexact && uv pip install -r odoo/requirements.txt && uv pip install -r requirements-addons-manifests.txt"
}
